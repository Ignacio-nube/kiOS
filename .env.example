# Variables del proyecto de Vercel (uno solo: landing en / y demo en /demo).
#
# En Vercel se cargan todas acá: Project → Settings → Environment Variables.
# En local, las VITE_ van en `apps/landing/.env.local` (Vite las lee desde
# la carpeta de la app, no desde la raíz) y ese archivo está en .gitignore.

# ── PÚBLICAS: entran al bundle que descarga el navegador ────────────────

# Demo web. NO hace falta definirla: por defecto es `/demo`, del mismo
# dominio. Solo se usa para apuntar a otro lado (ej. el dev server local).
# VITE_DEMO_URL=

# Instalador de escritorio. Acá va el link de descarga directa de Google
# Drive; `npm run build:installer` lo imprime armado a partir del ID del
# archivo. Vacío = el botón se muestra apagado con el motivo, no roto.
VITE_DOWNLOAD_URL=

# Casilla de soporte del pie y del mail de compra.
VITE_SUPPORT_EMAIL=hola@kios.click

# ── SECRETAS: nunca con prefijo VITE_ ───────────────────────────────────
# Ese prefijo es lo que Vite usa para decidir qué exponer al cliente: una
# clave con VITE_ delante termina en el JavaScript que cualquiera abre.

# Access token de Mercado Pago (Tus integraciones → Credenciales).
MP_ACCESS_TOKEN=

# Firma secreta del webhook (MP → Webhooks). Sin esto cualquiera puede
# simular un pago aprobado con un POST y llevarse una licencia.
MP_WEBHOOK_SECRET=

# El código de activación que reciben TODOS los que compran. El webhook no
# firma nada: solo reenvía esto por mail.
#
#   npm run license:sign -- "kiOS"
#   npm run license:verify -- "KIOS-…"    ← verificalo ANTES de pegarlo acá
#
# Ojo: acá va el CÓDIGO (empieza con KIOS-), NUNCA la clave privada. Con
# este modelo la clave privada no tiene por qué existir en el servidor —
# ésa es justamente la ventaja: si te entran al hosting se llevan un código
# que ya circula, no la capacidad de fabricar códigos nuevos.
SHARED_LICENSE_KEY=

# Envío de mail (Resend).
RESEND_API_KEY=
# Remitente verificado en Resend, ej: kiOS <hola@kios.click>
MAIL_FROM=

# URL pública del sitio. Arma los back_urls y el notification_url de Mercado
# Pago, así que tiene que ser el dominio de producción, con https y sin
# barra final.
PUBLIC_SITE_URL=https://kios.click
