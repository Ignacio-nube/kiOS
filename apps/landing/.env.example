# ── Landing (PÚBLICAS: entran al bundle que descarga el navegador) ──────
# URL de la demo web (build de apps/app desplegado).
VITE_DEMO_URL=
# Instalador de escritorio firmado (opcional hasta que exista una release).
VITE_DOWNLOAD_URL=
# Casilla de soporte que se muestra en el pie y en el mail de compra.
VITE_SUPPORT_EMAIL=hola@kios.com.ar

# ── Backend de compra (SECRETAS: solo servidor) ─────────────────────────
# NUNCA prefijarlas con VITE_. Ese prefijo es lo que Vite usa para decidir
# qué exponer al cliente: una clave privada con VITE_ delante termina en el
# JavaScript que cualquiera puede abrir.

# Access token de Mercado Pago (Tus integraciones → Credenciales).
MP_ACCESS_TOKEN=
# Firma secreta del webhook (MP → Webhooks). Sin esto cualquiera puede
# simular un pago aprobado con un POST y llevarse una licencia.
MP_WEBHOOK_SECRET=

# El código de activación que reciben TODOS los que compran. El webhook no
# firma nada: solo reenvía esto por mail.
#
# Se emite a mano con `npm run license:sign -- "kiOS"` y se verifica con
# `npm run license:verify` ANTES de pegarlo acá.
#
# Ojo: acá va el CÓDIGO (empieza con KIOS-), NUNCA la clave privada. Con
# este modelo la clave privada no tiene por qué existir en el servidor —
# ésa es justamente la ventaja: si te entran al hosting se llevan un código
# que ya circula, no la capacidad de fabricar códigos nuevos.
SHARED_LICENSE_KEY=

# Envío de mail (Resend).
RESEND_API_KEY=
# Remitente verificado en Resend, ej: kiOS <hola@kios.com.ar>
MAIL_FROM=

# URL pública del sitio, para armar los back_urls de Mercado Pago.
PUBLIC_SITE_URL=https://kios.com.ar
