{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "kiOS",
  "version": "0.1.0",
  "identifier": "ar.kios.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "kiOS",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "kiOS",
    "copyright": "© 2026 kiOS",
    "category": "Business",
    "shortDescription": "Punto de venta para kioscos y almacenes",
    "longDescription": "Punto de venta pensado para el mostrador real: escaneás el código, se agrega solo al ticket y cobrás en segundos. Lleva el stock, las cuentas de fiado y el cierre de caja. Todo se guarda en tu computadora.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "SpanishInternational"],
        "displayLanguageSelector": false
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
